+from copy import deepcopy
+
+import pytest
+from pydantic import ValidationError
+
+from aiperf.dataset.loader.weka_trace_models import WekaNormalRequest
+
+
+@pytest.mark.parametrize(
+    "update",
+    [
+        {"output_ids": None},
+        {"input_ids": []},
+        {"in": 3},
+        {"output_ids": [True]},
+        {"input_ids": [-1, 2]},
+    ],
+)
+def test_invalid_recorded_pairs_are_rejected(update):
+    row = {
+        "t": 0,
+        "type": "n",
+        "model": "test",
+        "in": 2,
+        "out": 1,
+        "input_ids": [1, 2],
+        "output_ids": [3],
+    }
+    with pytest.raises(ValidationError):
+        WekaNormalRequest.model_validate({**row, **update})
+
+
+def test_recorded_dag_tokens_survive_original_reconstruction(monkeypatch):
+    from aiperf.dataset.loader.weka_trace import WekaTraceLoader
+    from tests.unit.dataset.loader.test_weka_trace import (
+        FIXTURES,
+        _mk_user_config,
+        _stub_prompt_generator_for_reconstructor,
+    )
+
+    monkeypatch.setenv("AGENTX_REPLAY_MODE", "recorded")
+    loader = WekaTraceLoader(
+        filename=str(FIXTURES / "one_subagent.json"), run=_mk_user_config()
+    )
+    _stub_prompt_generator_for_reconstructor(loader)
+    data = loader.load_dataset()
+    for traces in data.values():
+        for trace in traces:
+            for outer in trace.requests:
+                requests = outer.requests if outer.type == "subagent" else [outer]
+                for index, req in enumerate(requests):
+                    req.input_ids = [index + 10] * req.input_length
+                    req.output_ids = [index + 20] * req.output_length
+    frozen = deepcopy(data)
+    conversations = loader.convert_to_conversations(data)
+    assert len(conversations) >= 2
+    assert any(turn.branch_ids for conv in conversations for turn in conv.turns)
+    assert any(turn.prerequisites for conv in conversations for turn in conv.turns)
+    for conv in conversations:
+        for turn in conv.turns:
+            req = frozen[turn.source_trace_id][0].requests[turn.source_outer_idx]
+            if turn.source_inner_idx is not None:
+                req = req.requests[turn.source_inner_idx]
+            assert turn.input_ids == req.input_ids
+            assert turn.output_ids == req.output_ids
+            assert turn.max_tokens == len(turn.output_ids)
+            assert turn.raw_messages is None
