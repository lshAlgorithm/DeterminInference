+                    )
+                continue
+            if turn.max_tokens != len(req.output_ids):
+                raise ValueError(
+                    "recorded output must not be truncated by synthesis settings"
+                )
+            turn.input_ids = list(req.input_ids)
+            turn.output_ids = list(req.output_ids)
+            turn.raw_messages = None
+            turn.texts = []
