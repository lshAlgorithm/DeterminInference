@@ -0,0 +1,12 @@
+from typing import Any
+
+from aiperf.common.models import RequestInfo
+from aiperf.endpoints.openai_completions import CompletionsEndpoint
+
+
+class SGLangTokenCompletionsEndpoint(CompletionsEndpoint):
+    def format_payload(self, request_info: RequestInfo) -> dict[str, Any]:
+        """Send complete token prompts with the worker's SGLang cache salt."""
+        if len(request_info.turns) != 1 or request_info.turns[0].input_ids is None:
+            raise ValueError("sglang-token-completions requires a complete token prompt")
+        return super().format_payload(request_info)
