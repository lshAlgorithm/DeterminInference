diff --git a/python/sglang/srt/sampling/token_replay.py b/python/sglang/srt/sampling/token_replay.py
new file mode 100644
index 0000000..24532b7
--- /dev/null
+++ b/python/sglang/srt/sampling/token_replay.py
@@ -0,0 +1,103 @@
+from dataclasses import dataclass
+from typing import Optional
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _replace_sampled_tokens(
+    sampled,
+    metadata,
+    positions,
+    batch_size: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    rows = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    valid = rows < batch_size
+    address = tl.load(metadata + rows * 3, valid, 0)
+    length = tl.load(metadata + rows * 3 + 1, valid, 0)
+    prompt_length = tl.load(metadata + rows * 3 + 2, valid, 0)
+    step = tl.load(positions + rows, valid, 0) - prompt_length + 1
+    replace = valid & (step >= 0) & (step < length)
+    recorded = tl.load(address.to(tl.pointer_type(tl.int64)) + step, replace, 0)
+    tl.store(sampled + rows, recorded, replace)
+
+
+@dataclass
+class TokenReplayBatch:
+    tokens: tuple[Optional[torch.Tensor], ...]
+    metadata: torch.Tensor
+
+    @classmethod
+    def from_requests(cls, reqs: list, device: str) -> Optional["TokenReplayBatch"]:
+        sequences = [r.sampling_params.replay_token_ids for r in reqs]
+        if not any(s is not None for s in sequences):
+            return None
+        packed = torch.tensor(
+            [
+                token
+                for sequence in sequences
+                if sequence is not None
+                for token in sequence
+            ],
+            dtype=torch.int64,
+            device=device,
+        )
+        tokens, metadata = [], []
+        offset = 0
+        for req, sequence in zip(reqs, sequences):
+            length = len(sequence) if sequence is not None else 0
+            view = packed[offset : offset + length] if length else None
+            tokens.append(view)
+            metadata.append(
+                [
+                    view.data_ptr() if view is not None else 0,
+                    length,
+                    len(req.origin_input_ids),
+                ]
+            )
+            offset += length
+        return cls(
+            tuple(tokens), torch.tensor(metadata, dtype=torch.int64, device=device)
+        )
+
+    def filter(
+        self, indices: torch.Tensor, keep_indices: list[int]
+    ) -> Optional["TokenReplayBatch"]:
+        tokens = tuple(self.tokens[i] for i in keep_indices)
+        if not any(token is not None for token in tokens):
+            return None
+        return TokenReplayBatch(tokens, self.metadata[indices])
+
+    @staticmethod
+    def merge(
+        left: Optional["TokenReplayBatch"],
+        right: Optional["TokenReplayBatch"],
+        left_size: int,
+        right_size: int,
+        device: str,
+    ) -> Optional["TokenReplayBatch"]:
+        if left is None and right is None:
+            return None
+        tokens, metadata = [], []
+        for batch, size in ((left, left_size), (right, right_size)):
+            if batch is None:
+                tokens.extend([None] * size)
+                metadata.append(
+                    torch.zeros((size, 3), dtype=torch.int64, device=device)
+                )
+            else:
+                tokens.extend(batch.tokens)
+                metadata.append(batch.metadata)
+        return TokenReplayBatch(tuple(tokens), torch.cat(metadata))
+
+    def apply(self, sampled: torch.Tensor, positions: torch.Tensor) -> None:
+        _replace_sampled_tokens[(triton.cdiv(sampled.numel(), 128),)](
+            sampled,
+            self.metadata,
+            positions,
+            sampled.numel(),
+            128,
+        )
